# ============================================================
# AgroManager - Variables de Entorno
# ============================================================
# Copia este archivo a .env y ajusta los valores según tu
# entorno (desarrollo, testing, producción).
#
# IMPORTANTE: Nunca commits .env con valores reales
# ============================================================

# APLICACIÓN
# dev / test / production
APP_ENV=development

# Modo debug (solo development)
DEBUG=True

# ============================================================
# BASE DE DATOS
# ============================================================

# DESARROLLO: SQLite local (recomendado para inicio rápido)
# Sin instalación de PostgreSQL necesaria
DATABASE_URL=sqlite:///./app.db

# ALTERNATIVA: PostgreSQL (para producción)
# Requiere PostgreSQL instalado y corriendo
# DATABASE_URL=postgresql://user:password@localhost:5432/agromanager_db

# ============================================================
# AUTENTICACIÓN JWT
# ============================================================

# Clave secreta para firmar tokens JWT
# IMPORTANTE: Cambiar en producción con valor aleatorio largo
# Generar: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-secret-key-change-in-production-please-use-random-value

# Algoritmo de firma (recomendado: HS256)
ALGORITHM=HS256

# Expiración de token (minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================
# CORS - Control de Orígenes
# ============================================================

# Orígenes permitidos para requests de frontend
# Separados por comas, sin espacios
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3000,http://localhost:3000

# ============================================================
# GOOGLE OAUTH (Opcional - no implementado aún)
# ============================================================

# Google Cloud Project credentials
# Dejar vacío si no se usa OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Callback URL después de Google OAuth login
GOOGLE_OAUTH_REDIRECT=http://127.0.0.1:8000/auth/google/callback

# ============================================================
# FRONTEND
# ============================================================

# URL del frontend (para redirecciones, CORS, etc.)
FRONTEND_URL=http://127.0.0.1:5173

# ============================================================
# SERVIDOR
# ============================================================

# Host para uvicorn
HOST=127.0.0.1

# Puerto para uvicorn
PORT=8000

# ============================================================
# LOGGING
# ============================================================

# log_level: debug / info / warning / error / critical
LOG_LEVEL=info

# ============================================================
# NOTAS IMPORTANTES
# ============================================================
#
# 1. Para desarrollo local:
#    - Usar SQLite (DATABASE_URL=sqlite:///./app.db)
#    - DEBUG=True
#    - SECRET_KEY puede ser cualquier valor
#
# 2. Para producción:
#    - Usar PostgreSQL
#    - DEBUG=False
#    - SECRET_KEY debe ser valor aleatorio seguro
#    - Cambiar CORS_ORIGINS a dominio real
#    - Usar HTTPS
#
# 3. Credenciales demo (creadas por seed_demo.py):
#    - admin@test.com / admin123
#    - user@test.com / user123
#
# 4. Para resetear datos:
#    python scripts/seed_demo.py --reset
#    python scripts/seed_demo.py
#
# ============================================================
