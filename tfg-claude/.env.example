# Ejemplo de variables de entorno para AgroManager
# Copia este archivo a .env y completa con tus valores

# Aplicación
APP_ENV=development
DEBUG=True

# Base de Datos
# IMPORTANTE: PostgreSQL es recomendado para desarrollo/producción
# Si DATABASE_URL no está definida, fallback a SQLite local (app.db)
# Para desarrollo rápido sin PostgreSQL instalado:
DATABASE_URL=postgresql://postgres:admin@localhost:5432/tfg_db
# O descomentar para SQLite local:
# DATABASE_URL=sqlite:///./app.db

# Autenticación JWT
SECRET_KEY=dev-secret-key-change-in-production-12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
# Orígenes permitidos (separados por comas)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3000,http://localhost:3000

# Google OAuth (opcional, sin implementación todavía)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT=http://127.0.0.1:8000/auth/google/callback

# Frontend
FRONTEND_URL=http://127.0.0.1:5173
